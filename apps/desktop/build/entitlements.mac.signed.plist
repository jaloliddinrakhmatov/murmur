<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Developer ID builds: Electron's frameworks and helpers, the main binary and
         murmur_native.node are all signed with one Team ID, so library validation stays on
         (no com.apple.security.cs.disable-library-validation). -->
    <!-- Hardened runtime: Electron's JIT needs these. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Dictation records from the microphone. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Connectors → Calendar reads events through EventKit, only after the person connects it. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
