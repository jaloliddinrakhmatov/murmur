{
  "name": "@murmur/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Murmur: dictation for macOS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "node --test \"test/*.test.ts\"",
    "smoke": "npm run build && node scripts/run-smoke.mjs",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "package": "npm run build && electron-builder --mac --dir",
    "release": "node scripts/release.mjs",
    "capture": "npm run build && env -u ELECTRON_RUN_AS_NODE electron . --capture",
    "compare": "npm run build && env -u ELECTRON_RUN_AS_NODE electron . --compare"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@murmur/account-api": "0.1.0",
    "@murmur/native": "0.1.0",
    "@murmur/speech": "0.1.0",
    "@murmur/text": "0.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "app.murmur.desktop",
    "productName": "Murmur",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "../../node_modules/electron/dist",
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!**/node_modules/@murmur/native/{target,crates,results,scripts,test}/**",
      "!**/node_modules/@murmur/native/{Cargo.toml,Cargo.lock,*.md}"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": "dir",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Murmur listens while you dictate, and while you record a meeting in Notetaker, and turns what is said into text.",
        "NSCalendarsFullAccessUsageDescription": "Murmur reads the meetings on your calendars, only on this Mac, to list your upcoming meetings in Notetaker and remind you when one starts.",
        "NSCalendarsUsageDescription": "Murmur reads the meetings on your calendars, only on this Mac, to list your upcoming meetings in Notetaker and remind you when one starts.",
        "NSAudioCaptureUsageDescription": "Murmur records your Mac's sound only while you record a meeting in Notetaker, so the other people in a call are in the transcript."
      }
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "afterPack": "build/after-pack.cjs"
  }
}
