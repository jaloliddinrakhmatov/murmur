# Copy to apps/desktop/.env for development. Everything here can also be set in the app's Settings.
# Values set in the app's Settings take effect after restart; environment values override them.

# openai | groq | deepgram | whisper.cpp
MURMUR_SPEECH_PROVIDER=openai

# API key for the cloud provider above. Prefer entering it in Settings (stored encrypted by macOS)
# instead of keeping it in a file.
MURMUR_SPEECH_API_KEY=

# Optional model override (defaults: gpt-4o-transcribe, whisper-large-v3-turbo, nova-3).
MURMUR_SPEECH_MODEL=

# Local development fallback: a running whisper.cpp server, e.g.
#   prototypes/.cache/src/whisper.cpp/build/bin/whisper-server -m prototypes/.cache/models/whisper/ggml-base.bin --port 8178
# Measured in M0: not production latency (large model ≈ 0.45× real time on an 8 GB M2).
MURMUR_WHISPER_URL=http://127.0.0.1:8178

# Push-to-talk shortcut (modifier + key; modifier-only keys are not supported in this version).
MURMUR_SHORTCUT=ctrl+opt+space
