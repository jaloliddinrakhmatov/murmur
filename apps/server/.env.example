# Copy to .env (git-ignored). Local development needs MURMUR_ENV=development (npm run dev sets it).
# Anything else, or no value, means production: real secrets, https MURMUR_PUBLIC_URL and real
# email/payment providers are then required.
MURMUR_ENV=development
DATABASE_URL=postgresql://murmur@127.0.0.1:54329/murmur_dev
PORT=4000
# Required in production: two different long random strings (openssl rand -hex 32).
MURMUR_PEPPER=dev-pepper-change-me
MURMUR_TOKEN_SECRET=dev-token-secret-change-me
# Development/test only: expose GET /v1/dev/outbox.
MURMUR_DEV_OUTBOX=1
# Required in production (https); the only Host header accepted there. Also the website origin allowed by
# CORS on /v1/public/* and the base of invite/referral links. In development it defaults to the
# local website (apps/web).
# MURMUR_PUBLIC_URL=http://localhost:3000
# Real email (optional in development, required in production). `npm run mail:setup -w apps/server`
# writes these for you. Gmail needs an App password (not your normal password); TLS is always on.
# MURMUR_SMTP_HOST=smtp.gmail.com
# MURMUR_SMTP_PORT=587
# MURMUR_SMTP_USER=you@gmail.com
# MURMUR_SMTP_PASS=abcdabcdabcdabcd
# MURMUR_MAIL_FROM='"Murmur" <you@gmail.com>'
# Website help chat (optional). `npm run help:setup -w apps/server` writes these for you. Provider:
# groq, gemini or openai (fake = development/test only, answers from the guide without any AI service).
# MURMUR_HELP_PROVIDER=groq
# MURMUR_HELP_API_KEY=
# MURMUR_HELP_MODEL=
# Answers per day, all visitors together (default 500).
# MURMUR_HELP_DAILY_LIMIT=500
# Shown to visitors who need a person.
# MURMUR_HELP_CONTACT=
